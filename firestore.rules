rules_version = '2';

// Reglas de Firestore del proyecto cuadrante-755f5. Publicadas tambien en la
// consola de Firebase; este fichero las deja bajo control de versiones para
// que no dependan de una sesion del navegador.
//
// Despliegue (cuando cambien):
//   firebase deploy --only firestore:rules
//
// Cada usuario solo puede leer y escribir su propio documento de estado: el
// de /usuarios/{su-uid}. Nadie mas ve ni toca los datos de nadie.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
